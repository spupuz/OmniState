# OmniState configuration — copy to .env and edit
# NEVER commit this file (it's in .gitignore and .dockerignore)

# ============================================
# REQUIRED
# ============================================
# Absolute path on the host to your projects root.
# Mounted at /workspaces (read-only) for MCP path translation.
PROJECTS_ROOT=/home/youruser/projects

# ============================================
# OPTIONAL — Server
# ============================================
# Host port for dashboard + MCP (default 8347)
OMNISTATE_HOST_PORT=8347

# Host folder where all server data lives (bind-mounted at /data)
# Default: ./data inside the OmniState directory
DATA_HOST_DIR=./data

# Seconds between project discovery scans (default 300)
OMNISTATE_SCAN_INTERVAL_SECONDS=300

# Auto-import v1 memory files when a project with such files is discovered (default false)
OMNISTATE_AUTO_IMPORT_LEGACY=false

# Backup retention in days (default 7)
OMNISTATE_BACKUP_RETENTION_DAYS=7

# Dashboard auth: set to false to allow dashboard access without token
# while keeping /api/* and /mcp protected (default true)
OMNISTATE_DASHBOARD_AUTH=true

# Optional Bearer token protecting /api/* and MCP session creation.
# Set this if the box is reachable by others on the LAN.
# If empty, the server is wide open (no auth).
OMNISTATE_AUTH_TOKEN=

# ============================================
# OPTIONAL — GitHub PR Health
# ============================================
# GitHub accounts/orgs to scan, comma-separated (empty = scans disabled)
GITHUB_ACCOUNTS=

# GitHub Personal Access Token (enables GraphQL, private repos, extended metrics)
# Never exposed by API/dashboard/MCP.
GITHUB_TOKEN=

# Hours between automatic scans (default 6)
GITHUB_SCAN_INTERVAL_HOURS=6

# ============================================
# OPTIONAL — Supermemory Integration
# ============================================
# Enable Supermemory integration (default true)
SUPERMEMORY_ENABLED=true

# Supermemory API key. Leave placeholder to use built-in local server.
SUPERMEMORY_API_KEY=sm_your_local_api_key_here

# Supermemory base URL (default http://localhost:6767 for built-in server)
SUPERMEMORY_BASE_URL=http://localhost:6767

# Supermemory API version (default v5)
SUPERMEMORY_API_VERSION=v5

# Default Supermemory namespace
SUPERMEMORY_DEFAULT_SPACE=sm_project_default