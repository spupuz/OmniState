# OmniState — container configuration
# Copy this file to .env and fill it in:  cp .env.example .env
# The .env file is NEVER committed (see .gitignore / .dockerignore).

# ── Projects ────────────────────────────────────────────────────────────────
# ABSOLUTE path on the host to the root of your projects.
# Mounted read-only into the container at /workspaces.
# Examples: /home/mario/projects | /srv/dev | /data/workspaces
PROJECTS_ROOT=/home/youruser/projects

# ── Network ─────────────────────────────────────────────────────────────────
# Host port for dashboard + MCP. The container always listens on 8347.
OMNISTATE_HOST_PORT=8347

# ── GitHub PR Health (optional) ─────────────────────────────────────────────
# GitHub accounts/orgs to scan, comma-separated (empty = scans disabled).
GITHUB_ACCOUNTS=

# Personal Access Token: enables GraphQL, private repos and extended metrics
# (drafts, no-reviewer, stale, PR age). WITHOUT token: REST only, public repos.
# Suggested scope: repo (or read:org for organizations).
GITHUB_TOKEN=

# Hours between automatic scans (default 6).
GITHUB_SCAN_INTERVAL_HOURS=6

# How often (seconds) the server looks for NEW projects in PROJECTS_ROOT (default 300).
# OMNISTATE_SCAN_INTERVAL_SECONDS=300

# Auto-import legacy v1 memory files (tasks-history.json, chunks/, project-summary.md)
# when a NEW project is discovered. Default: false (import stays explicit).
# OMNISTATE_AUTO_IMPORT_LEGACY=true
